<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<%@ page import="java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<title>Employee Details</title>
<style>
body { font-family: Arial; margin: 40px; }
.error { color: red; }
</style>
</head>
<body>
<%
String name = request.getParameter("name");
String ageStr = request.getParameter("age");
String email = request.getParameter("email");
String gender = request.getParameter("gender");
String[] hobbies = request.getParameterValues("hobbies");
boolean isValid = true;
if (name == null || name.trim().isEmpty()) isValid = false;
if (ageStr == null || ageStr.trim().isEmpty()) isValid = false;
if (email == null || email.trim().isEmpty()) isValid = false;
if (gender == null) isValid = false;
int age = 0;
try {
age = Integer.parseInt(ageStr);
if (age < 18 || age > 60) isValid = false;
} catch (Exception e) {
isValid = false;
}
if (!isValid) {
response.sendRedirect("index.jsp?error=1");
return;
}
%>
<h2>Submitted Employee Details</h2>
<p><strong>Name:</strong> <%= name %></p>
<p><strong>Age:</strong> <%= age %></p>
<p><strong>Email:</strong> <%= email %></p>
<p><strong>Gender:</strong> <%= gender %></p>
<p><strong>Hobbies:</strong>
<%
if (hobbies != null) {
for (String h : hobbies) {
out.print(h + " ");
}
} else {
out.print("None");
}
%>
</p>
</body>
</html>
