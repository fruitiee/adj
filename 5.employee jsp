<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<title>Employee Form</title>
<style>
body { font-family: Arial; margin: 40px; }
.error { color: red; }
</style>
</head>
<body>
<h2>Employee Registration</h2>
<%
String error = request.getParameter("error");
if ("1".equals(error)) {
%>
<p class="error">Please fill all the fields correctly!</p>
<% } %>
<form action="result.jsp" method="post">
<label>Name:</label>
<input type="text" name="name" required><br><br>
<label>Age:</label>
<input type="number" name="age" required min="18" max="60"><br><br>
<label>Email:</label>
<input type="email" name="email" required><br><br>
<label>Gender:</label>
<input type="radio" name="gender" value="Male" required> Male
<input type="radio" name="gender" value="Female"> Female<br><br>
<label>Hobbies:</label><br>
<input type="checkbox" name="hobbies" value="Reading"> Reading<br>
<input type="checkbox" name="hobbies" value="Traveling"> Traveling<br>
<input type="checkbox" name="hobbies" value="Gaming"> Gaming<br><br>
<input type="submit" value="Submit">
</form>
</body>
</html>

