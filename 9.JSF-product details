<%@ page language="java" contentType="text/html; charset=UTF-8" import="java.util.*" %>
<%!
    class Product {
        int id; String name, category; double price; int stock;
        Product(int id, String name, String category, double price, int stock) {
            this.id = id; this.name = name; this.category = category;
            this.price = price; this.stock = stock;
        }
    }
%>
<%
    // Hardcoded product data (no DB) - 12 products to demo pagination
    List<Product> products = new ArrayList<>();
    products.add(new Product(1, "Laptop", "Electronics", 55000.0, 10));
    products.add(new Product(2, "Smartphone", "Electronics", 25000.0, 20));
    products.add(new Product(3, "Headphones", "Accessories", 2000.0, 50));
    products.add(new Product(4, "Chair", "Furniture", 3500.0, 15));
    products.add(new Product(5, "Book", "Stationery", 500.0, 100));
    products.add(new Product(6, "Monitor", "Electronics", 12000.0, 8));
    products.add(new Product(7, "Keyboard", "Accessories", 1500.0, 40));
    products.add(new Product(8, "Mouse", "Accessories", 800.0, 60));
    products.add(new Product(9, "Desk", "Furniture", 7000.0, 12));
    products.add(new Product(10, "Notebook", "Stationery", 60.0, 200));
    products.add(new Product(11, "Pen", "Stationery", 10.0, 500));
    products.add(new Product(12, "Printer", "Electronics", 9000.0, 6));

    // Filters
    String fId = request.getParameter("fId");
    String fName = request.getParameter("fName");
    String fCategory = request.getParameter("fCategory");
    String fPrice = request.getParameter("fPrice");
    String fStock = request.getParameter("fStock");

    // Sort
    String sortCol = request.getParameter("sort");
    String order = request.getParameter("order");
    if (sortCol == null) sortCol = "id";
    if (order == null) order = "asc";

    // Pagination params
    int pageSize = 5;
    int currentPage = 1;
    try {
        currentPage = Integer.parseInt(request.getParameter("page"));
    } catch (Exception e) { currentPage = 1; }
    if (currentPage < 1) currentPage = 1;

    // Apply filters
    List<Product> filtered = new ArrayList<>();
    for (Product p : products) {
        boolean match = true;
        if (fId != null && !fId.isEmpty() && !String.valueOf(p.id).contains(fId)) match = false;
        if (fName != null && !fName.isEmpty() && !p.name.toLowerCase().contains(fName.toLowerCase())) match = false;
        if (fCategory != null && !fCategory.isEmpty() && !p.category.toLowerCase().contains(fCategory.toLowerCase())) match = false;
        if (fPrice != null && !fPrice.isEmpty() && !String.valueOf(p.price).contains(fPrice)) match = false;
        if (fStock != null && !fStock.isEmpty() && !String.valueOf(p.stock).contains(fStock)) match = false;
        if (match) filtered.add(p);
    }

    // Apply sorting
    final String sCol = sortCol;
    final boolean asc = order.equals("asc");
    Collections.sort(filtered, new Comparator<Product>() {
        public int compare(Product a, Product b) {
            int result = 0;
            switch (sCol) {
                case "name": result = a.name.compareTo(b.name); break;
                case "category": result = a.category.compareTo(b.category); break;
                case "price": result = Double.compare(a.price, b.price); break;
                case "stock": result = Integer.compare(a.stock, b.stock); break;
                default: result = Integer.compare(a.id, b.id);
            }
            return asc ? result : -result;
        }
    });

    // Pagination calculation
    int totalRecords = filtered.size();
    int totalPages = (int) Math.ceil((double) totalRecords / pageSize);
    if (totalPages < 1) totalPages = 1;
    if (currentPage > totalPages) currentPage = totalPages;

    int startIndex = (currentPage - 1) * pageSize;
    int endIndex = Math.min(startIndex + pageSize, totalRecords);
    List<Product> pageData = filtered.subList(startIndex, endIndex);

    String base = "products.jsp";

    // Preserve filters & sort when changing page
    String qsPrefix = "sort=" + sortCol + "&order=" + order
        + "&fId=" + (fId != null ? fId : "")
        + "&fName=" + (fName != null ? fName : "")
        + "&fCategory=" + (fCategory != null ? fCategory : "")
        + "&fPrice=" + (fPrice != null ? fPrice : "")
        + "&fStock=" + (fStock != null ? fStock : "");
%>
<!DOCTYPE html>
<html>
<head>
    <title>Product List</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        .container { border: 1px solid #ddd; border-radius: 8px; padding: 20px; }
        h1 { font-family: 'Times New Roman', serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; background: #f8f9fa; padding: 10px; font-size: 14px; }
        th a { text-decoration: none; color: #333; }
        td { padding: 10px; border-top: 1px solid #eee; font-size: 14px; }
        .filter-row td, .filter-row th { padding: 5px 10px; }
        .filter-row input { width: 90%; padding: 6px; border: 1px solid #ccc; border-radius: 4px; }
        .pagination { text-align: center; margin: 15px 0; }
        .pagination a { text-decoration: none; color: #555; margin: 0 6px; }
        .pagination a.disabled { color: #ccc; pointer-events: none; }
        .pagination span.active {
            background: #2196F3; color: white; padding: 4px 10px;
            border-radius: 50%; margin: 0 4px;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Product List</h1>

    <%
        String pagerHtml = buildPager(currentPage, totalPages, base, qsPrefix);
    %>

    <form method="get" action="products.jsp" id="filterForm">
        <input type="hidden" name="sort" value="<%= sortCol %>" />
        <input type="hidden" name="order" value="<%= order %>" />
        <input type="hidden" name="page" value="1" />
        <table>
            <tr>
                <th><a href="<%= base %>?sort=id&order=<%= sCol.equals("id") && asc ? "desc" : "asc" %>">ID &#8593;&#8595;</a></th>
                <th><a href="<%= base %>?sort=name&order=<%= sCol.equals("name") && asc ? "desc" : "asc" %>">Name &#8593;&#8595;</a></th>
                <th><a href="<%= base %>?sort=category&order=<%= sCol.equals("category") && asc ? "desc" : "asc" %>">Category &#8593;&#8595;</a></th>
                <th><a href="<%= base %>?sort=price&order=<%= sCol.equals("price") && asc ? "desc" : "asc" %>">Price &#8593;&#8595;</a></th>
                <th><a href="<%= base %>?sort=stock&order=<%= sCol.equals("stock") && asc ? "desc" : "asc" %>">Stock &#8593;&#8595;</a></th>
            </tr>
            <tr class="filter-row">
                <td><input type="text" name="fId" value="<%= fId != null ? fId : "" %>" onchange="document.getElementById('filterForm').submit()" /></td>
                <td><input type="text" name="fName" value="<%= fName != null ? fName : "" %>" onchange="document.getElementById('filterForm').submit()" /></td>
                <td><input type="text" name="fCategory" value="<%= fCategory != null ? fCategory : "" %>" onchange="document.getElementById('filterForm').submit()" /></td>
                <td><input type="text" name="fPrice" value="<%= fPrice != null ? fPrice : "" %>" onchange="document.getElementById('filterForm').submit()" /></td>
                <td><input type="text" name="fStock" value="<%= fStock != null ? fStock : "" %>" onchange="document.getElementById('filterForm').submit()" /></td>
            </tr>
            <% for (Product p : pageData) { %>
            <tr>
                <td><%= p.id %></td>
                <td><%= p.name %></td>
                <td><%= p.category %></td>
                <td><%= p.price %></td>
                <td><%= p.stock %></td>
            </tr>
            <% } %>
        </table>
    </form>

    <div class="pagination"><%= pagerHtml %></div>
</div>
</body>
</html>

<%!
    // Builds pagination links: << < 1 2 3 > >>
    public String buildPager(int currentPage, int totalPages, String base, String qsPrefix) {
        StringBuilder sb = new StringBuilder();

        if (currentPage > 1) {
            sb.append("<a href='").append(base).append("?page=1&").append(qsPrefix).append("'>&laquo;</a> ");
        } else {
            sb.append("<a class='disabled'>&laquo;</a> ");
        }

        if (currentPage > 1) {
            sb.append("<a href='").append(base).append("?page=").append(currentPage - 1).append("&").append(qsPrefix).append("'>&lsaquo;</a> ");
        } else {
            sb.append("<a class='disabled'>&lsaquo;</a> ");
        }

        for (int i = 1; i <= totalPages; i++) {
            if (i == currentPage) {
                sb.append("<span class='active'>").append(i).append("</span> ");
            } else {
                sb.append("<a href='").append(base).append("?page=").append(i).append("&").append(qsPrefix).append("'>").append(i).append("</a> ");
            }
        }

        if (currentPage < totalPages) {
            sb.append("<a href='").append(base).append("?page=").append(currentPage + 1).append("&").append(qsPrefix).append("'>&rsaquo;</a> ");
        } else {
            sb.append("<a class='disabled'>&rsaquo;</a> ");
        }

        if (currentPage < totalPages) {
            sb.append("<a href='").append(base).append("?page=").append(totalPages).append("&").append(qsPrefix).append("'>&raquo;</a>");
        } else {
            sb.append("<a class='disabled'>&raquo;</a>");
        }

        return sb.toString();
    }
%>



